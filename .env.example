# PKM Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Comma-separated paths to Obsidian vaults where plugin should be auto-deployed after build
# Example: C:/Users/YourName/Documents/MyVault,C:/Users/YourName/Documents/TestVault
DESTINATION_VAULTS=

# Note: `npm run release` (release.js) needs NO env vars of its own since 2026-09-07 -
# it only prepares the release (version check, notes, local build check). Publishing
# (tag push -> build -> attested GitHub release) runs in GitHub Actions, not here.
# See RELEASE_PROCESS.md.
