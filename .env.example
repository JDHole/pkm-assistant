# PKM Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Comma-separated paths to Obsidian vaults where plugin should be auto-deployed after build
# Example: C:/Users/YourName/Documents/MyVault,C:/Users/YourName/Documents/TestVault
DESTINATION_VAULTS=

# Name of the Obsidian configuration folder inside EVERY vault listed above - usually
# Obsidian's default configuration folder, but any vault owner can rename it, and a build
# running in plain Node has no `Vault#configDir` to ask. So the build never guesses it:
# with DESTINATION_VAULTS set and this one empty you get one warning and no deploy
# (the build itself still succeeds).
# Example: DESTINATION_CONFIG_DIR=.obsidian
DESTINATION_CONFIG_DIR=

# Note: `npm run release` (release.js) needs NO env vars of its own since 2026-09-07 -
# it only prepares the release (version check, notes, local build check). Publishing
# (tag push -> build -> attested GitHub release) runs in GitHub Actions, not here.
# See RELEASE_PROCESS.md.
